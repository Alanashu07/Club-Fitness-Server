// ============================================================================
// ATTENDANCE, GAMIFICATION, FEEDBACK & DOCUMENTS
// ============================================================================

model Attendance {
  id         String   @id @default(cuid())
  member     User     @relation(fields: [memberId], references: [id])
  memberId   String

  checkInAt  DateTime @default(now())
  checkOutAt DateTime?
  method     String   @default("QR") // QR | MANUAL

  @@index([memberId])
  @@index([checkInAt])
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique // "30-Day Streak", "First Workout", etc.
  description String?
  iconName    String?

  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  badgeId   String
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model Feedback {
  id        String   @id @default(cuid())
  member    User     @relation(fields: [memberId], references: [id])
  memberId  String

  category  String   // "class" | "trainer" | "facility" | "general"
  rating    Int      // 1-5
  comment   String?
  refId     String?  // optional reference to GymClass id, trainer User id, etc.

  createdAt DateTime @default(now())

  @@index([memberId])
}

model Document {
  id         String   @id @default(cuid())
  title      String
  fileUrl    String
  category   String?  // "rules" | "waiver" | "workout-pdf" | "other"

  uploadedBy User     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  uploadedById String

  createdAt  DateTime @default(now())
}
