// ============================================================================
// ANNOUNCEMENTS & NOTIFICATIONS
// ============================================================================

model Announcement {
  id             String              @id @default(cuid())
  title          String
  body           String
  type           AnnouncementType    @default(ANNOUNCEMENT)

  createdBy      User                @relation("AnnouncementCreator", fields: [createdById], references: [id])
  createdById    String

  audienceType   AudienceType        @default(ALL)
  audiencePlanIds String[]           // used when audienceType = PLAN_TIER
  audienceUserIds String[]           // used when audienceType = INDIVIDUAL

  channels       NotificationChannel[]

  // Offer-specific fields
  discountLabel  String?
  offerExpiresAt DateTime?

  isScheduled    Boolean             @default(false)
  scheduledFor   DateTime?
  sentAt         DateTime?
  isDraft        Boolean             @default(false)

  createdAt      DateTime            @default(now())

  notifications  Notification[]

  @@index([createdById])
  @@index([type])
}

model Notification {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id])
  userId         String

  announcement   Announcement? @relation(fields: [announcementId], references: [id])
  announcementId String?

  title          String
  body           String
  channel        NotificationChannel

  isRead         Boolean       @default(false)
  sentAt         DateTime      @default(now())

  @@index([userId])
  @@index([announcementId])
}
