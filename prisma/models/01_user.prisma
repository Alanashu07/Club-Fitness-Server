// ============================================================================
// USERS & MEMBERSHIP PLANS
// ============================================================================

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

model User {
  id              String     @id @default(cuid())
  name            String
  phone           String     @unique
  email           String?    @unique
  passwordHash    String?
  profileImageUrl String?
  role            Role       @default(MEMBER)
  status          UserStatus @default(ACTIVE)
  googleId        String?    @unique
  firebaseUid     String?    @unique

  dateOfBirth      DateTime?
  emergencyContact String?
  medicalNotes     String?

  // Membership (only relevant for MEMBER role)
  membershipPlanId   String?
  membershipPlan     MembershipPlan? @relation("MemberPlan", fields: [membershipPlanId], references: [id])
  membershipStart    DateTime?
  membershipEnd      DateTime?
  contentAccessUntil DateTime? // grace period override (admin-configurable)

  // Trainer assignment (for MEMBER role)
  assignedTrainerId String?
  assignedTrainer   User?   @relation("TrainerMembers", fields: [assignedTrainerId], references: [id])
  trainees          User[]  @relation("TrainerMembers")

  // Staff-only fields
  staffTitle String?
  hireDate   DateTime?

  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  devicePin        Int?     @unique // numeric PIN enrolled on the device
  deviceSN         String? // which device this member is enrolled on
  blocked          Boolean  @default(false)
  graceEntriesUsed Int      @default(0)

  // ── Relations ───────────────────────────────────────────────────────────
  feeRecords           FeeRecord[]          @relation("MemberFees")
  approvedFees         FeeRecord[]          @relation("ApprovedByStaff")
  workoutPlansCreated  WorkoutPlan[]        @relation("PlanCreator")
  workoutAssignments   WorkoutAssignment[]  @relation("AssignedMember")
  productOrders        ProductOrder[]       @relation("MemberOrders")
  processedOrders      ProductOrder[]       @relation("ProcessedByStaff")
  announcementsCreated Announcement[]       @relation("AnnouncementCreator")
  notifications        Notification[]
  attendanceRecords    Attendance[]
  deviceCheckIns       DeviceCheckInEvent[]
  bodyMeasurements     BodyMeasurement[]
  classBookings        ClassBooking[]
  equipmentBookings    EquipmentBooking[]
  feedback             Feedback[]
  badges               UserBadge[]
  documentsUploaded    Document[]           @relation("DocumentUploader")
  rotationTokens       RotationToken[]
  offerRedemptions     UserOffer[]

  @@index([role])
  @@index([status])
  @@index([membershipPlanId])
}

model MembershipPlan {
  id           String   @id @default(cuid())
  name         String
  durationDays Int
  price        Decimal  @db.Decimal(10, 2)
  description  String?
  features     String[] // e.g. ["Gym Floor", "Sauna", "Classes"]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  offers       Offer[]

  members    User[]      @relation("MemberPlan")
  feeRecords FeeRecord[]

  @@index([isActive])
}

// ============================================================================
// AUTH — ROTATION TOKENS (long-lived session tokens, supports blacklisting)
// ============================================================================

model RotationToken {
  id      String @id @default(cuid())
  tokenId String @unique // the unique id embedded inside the JWT payload
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  revokedAt DateTime? // non-null = blacklisted (logout / rotation / security action)
  expiresAt DateTime // mirrors the JWT's own expiry, lets you prune old rows

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenId])
}

model OtpToken {
  id         String    @id @default(uuid())
  email      String
  otpHash    String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email])
}

enum OfferDiscountType {
  PERCENTAGE
  FLAT
}

// When the offer can be used
enum OfferAppliesTo {
  NEW_MEMBER // only when creating a member
  RENEWAL // only when renewing
  BOTH
}

enum RedemptionSource {
  NEW_MEMBER
  RENEWAL
}

// ── Offer: created by admin, linked to membership plans ─────────────────────

model Offer {
  id          String  @id @default(cuid())
  name        String // "Diwali 20% off"
  code        String? @unique // optional promo code, stored UPPERCASE
  description String?

  discountType      OfferDiscountType
  discountValue     Decimal           @db.Decimal(10, 2) // % (0-100) or flat amount
  maxDiscountAmount Decimal?          @db.Decimal(10, 2) // cap, mainly for PERCENTAGE

  appliesTo OfferAppliesTo @default(BOTH)

  // Plan linking. appliesToAllPlans = true ignores `plans`.
  appliesToAllPlans Boolean          @default(false)
  plans             MembershipPlan[]

  validFrom  DateTime?
  validUntil DateTime?

  maxRedemptions  Int? // null = unlimited (total across all users)
  perUserLimit    Int? @default(1) // null = unlimited per user
  redemptionCount Int  @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions UserOffer[]

  @@index([isActive])
  @@index([validUntil])
}

// ── UserOffer: an offer actually used by a user (one row per redemption) ────
// Snapshot columns keep history correct even if the offer is edited later.

model UserOffer {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  offer   Offer  @relation(fields: [offerId], references: [id])
  offerId String

  feeRecord   FeeRecord? @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)
  feeRecordId String?    @unique

  source RedemptionSource

  offerName      String
  discountType   OfferDiscountType
  discountValue  Decimal           @db.Decimal(10, 2)
  originalAmount Decimal           @db.Decimal(10, 2) // plan price before discount
  discountAmount Decimal           @db.Decimal(10, 2)
  finalAmount    Decimal           @db.Decimal(10, 2) // what the member owes

  redeemedAt DateTime @default(now())

  @@index([userId])
  @@index([offerId])
  @@index([userId, offerId])
}
